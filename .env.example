# Copy to .env and fill in real values. .env itself is gitignored.
#
# Every EXPO_PUBLIC_* variable is inlined into the client bundle at build
# time, so none of these are secrets - anyone with the app can read them.
# Never put a server-side key here; it would ship to every device.
#
# No spaces around "=".

EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com/api
EXPO_PUBLIC_FIREBASE_API_KEY=AIza...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:android:abcdef
